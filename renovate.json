{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "addLabels": ["dependencies"],
  "timezone": "Asia/Tokyo",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchDatasources": ["github-releases", "github-tags"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "pnpm のメジャー更新は設定移行（pnpm-workspace.yaml の allowBuilds など）を伴うため自動マージしない",
      "matchManagers": ["npm"],
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Node のバージョンは package.json の engines.node を単一の情報源とし、GitHub Actions は node-version-file 経由で読む",
      "matchManagers": ["npm"],
      "matchDepNames": ["node"],
      "versioning": "node",
      "groupName": "node version"
    }
  ]
}
